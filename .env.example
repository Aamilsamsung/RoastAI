GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:4b
BOT_ENABLED=false
DRY_RUN=true
ROAST_MODE=savage
ROAST_INTENSITY=7
PROFANITY_LEVEL=light
CUSTOM_INSTRUCTIONS=
REPLY_DELAY_SECONDS=0
COOLDOWN_SECONDS=10
MAX_REPLY_LENGTH=300
INPUT_LANGUAGE=auto
REPLY_LANGUAGE=same
SCRIPT_MODE=roman
META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Local SQLite is for development only. Production must use PostgreSQL.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./roastbot.db
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
# Set a random 32+ character value. Required in production; enter it in workspace login.
ADMIN_TOKEN=
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_LOGIN_TYPE=instagram
AI_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=20

# Frontend only: put this in frontend/.env.local locally, or frontend Render env.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Identity Services: public web OAuth client ID (no client secret needed)
GOOGLE_CLIENT_ID=
# Facebook Page Messenger: server-only access token
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_API_VERSION=v23.0
# Reserved for approved Snapchat brand–creator integration; no general DM bot
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_PROFILE_ID=

# Per-attempt timeout and maximum attempts within AI_TIMEOUT_SECONDS total budget
AI_ATTEMPT_TIMEOUT_SECONDS=12
AI_MAX_ATTEMPTS=2
# Keep false until owner-approved controlled platform delivery tests pass
SOCIAL_DELIVERY_APPROVED=false

# User-owned official social connections (server only)
# Canonical public HTTPS backend origin; never include a path
BACKEND_URL=
# Random 32+ character encryption secret; keep stable and back up separately
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Instagram product's app ID and secret, distinct from Google OAuth
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Meta App ID; META_APP_SECRET and META_VERIFY_TOKEN above are also required
META_APP_ID=
FACEBOOK_LOGIN_CONFIG_ID=
# Facebook Login for Business Embedded Signup configuration ID
WHATSAPP_SIGNUP_CONFIG_ID=
