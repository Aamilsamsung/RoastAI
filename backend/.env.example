GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:4b
BOT_ENABLED=false
DRY_RUN=true
ROAST_MODE=savage
ROAST_INTENSITY=7
PROFANITY_LEVEL=light
CUSTOM_INSTRUCTIONS=
REPLY_DELAY_SECONDS=0
COOLDOWN_SECONDS=10
MAX_REPLY_LENGTH=300
INPUT_LANGUAGE=auto
REPLY_LANGUAGE=same
SCRIPT_MODE=roman
META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Local SQLite is for development only. Production must use PostgreSQL.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./roastbot.db
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
# Set a random 32+ character value. Required in production; enter it in workspace login.
ADMIN_TOKEN=
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_LOGIN_TYPE=instagram
AI_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=20

# Google Identity Services: public web OAuth client ID (no client secret needed)
GOOGLE_CLIENT_ID=
# Facebook Page Messenger: server-only access token
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_API_VERSION=v23.0
# Reserved for approved Snapchat brand–creator integration; no general DM bot
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_PROFILE_ID=
